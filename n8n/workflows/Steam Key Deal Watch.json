    {
      "id": "989c8325-5629-45db-9e18-0c2c94789c9a",
      "name": "FX Rate EUR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        256
      ],
      "parameters": {
        "url": "https://api.frankfurter.app/latest?from=USD&to=EUR",
        "options": {}
      },
      "notes": "USD to EUR daily rate from ECB, free and keyless.",
      "notesInFlow": true
    },
    {
      "id": "c98c636e-0c5d-4317-8c71-164e9c4e3aa4",
      "name": "Build Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        496
      ],
      "parameters": {
        "jsCode": "\n      const details = $('Steam FR Prices').all()[0]?.json ?? {};\n      const dealsRaw = $('GG Deals USD').all()[0]?.json?.data ?? {};\n      const rateObj = $('FX Rate EUR').all()[0]?.json ?? {};\n      const rate = rateObj.rates?.EUR ?? 1;\n      const rows = [];\n      for (const [appid, g] of Object.entries(dealsRaw)) {\n        const s = details[appid]?.data;\n        const steamCents = s?.price_overview?.final;\n        if (g.prices == null || steamCents == null) {\n          rows.push({\n            json: {\n              appid,\n              title: s?.name ?? g.title ?? '(unknown)',\n              steamEUR: null,\n              keyEUR: null,\n              gapEUR: null,\n              gapPct: null,\n              deal: 'n/a',\n              suspect: 'yes',\n              offerUrl: g.url ?? '',\n              note: 'region lock or missing data - manual check'\n            }\n          });\n          continue;\n        }\n        const steamEUR = Math.round((steamCents / 100) * 100) / 100;\n        const keyEUR = Math.round(g.prices.currentKeyshops * rate * 100) / 100;\n        const gapEUR = Math.round((steamEUR - keyEUR) * 100) / 100;\n        const gapPct = steamEUR > 0 ? Math.round((gapEUR / steamEUR) * 1000) / 10 : 0;\n        rows.push({\n          json: {\n            appid,\n            title: s?.name ?? g.title,\n            steamEUR,\n            keyEUR,\n            gapEUR,\n            gapPct,\n            deal: keyEUR < steamEUR ? 'yes' : 'no',\n            suspect: gapPct > 60 ? 'check region' : 'no',\n            offerUrl: g.url,\n            note: ''\n          }\n        });\n      }\n      return rows.length ? rows : [{ json: { title: '(no deals data)', note: 'all games null or missing' } }];\n      "
      },
      "notes": "Merges Steam FR prices, GG.deals USD prices and EUR rate; marks region-locked games as manual checks.",
      "notesInFlow": true
    },
    {
      "id": "166edcc6-2340-4aa9-943d-9a835ab698ed",
      "name": "Convert To File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        960,
        496
      ],
      "parameters": {
        "options": {
          "delimiter": ",",
          "fileName": "=steam-deals-{{ $today }}.csv",
          "headerRow": true
