    },
    {
      "id": "74664dca-0964-43a3-be9d-9c83e370915e",
      "name": "Compose Deals XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        912
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst jeux = rows\n  .filter(r => r.title)\n  .map(r =>\n    r.deal === 'n/a'\n      ? '<jeu><nom>' + r.title + '</nom><statut>indisponible</statut></jeu>'\n      : '<jeu><nom>' + r.title + '</nom><steam>' + r.steamEUR + '</steam><cle>' + r.keyEUR + '</cle><ecart>' + r.gapEUR + '</ecart><ecartPct>' + r.gapPct + '</ecartPct><lien>' + (r.offerUrl || 'none') + '</lien></jeu>'\n  )\n  .join('\\n  ');\nreturn [{ json: { xml: '<jeux>\\n  ' + jeux + '\\n</jeux>' } }];"
      }
    },
